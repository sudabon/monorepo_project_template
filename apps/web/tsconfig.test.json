{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    // Tests read the repository from disk, so they need Node types. The app
    // project stays without them so application code cannot reach for Node.
    "types": ["vite/client", "node"]
  },
  "include": ["src"],
  "exclude": []
}
