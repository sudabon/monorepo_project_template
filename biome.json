{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "files": {
    "includes": [
      "apps/**",
      "packages/**",
      "!!packages/api-client/src/generated",
      "scripts/**",
      "tests/**",
      "*.json",
      "*.ts",
      "*.mjs",
      "*.js",
      ".openspec-e2e-kit.json"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  }
}
