{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "files": {
    "includes": [
      "apps/**",
      "packages/**",
      "scripts/check-toolchain.mjs",
      "tests/toolchain/**",
      "package.json",
      "biome.json",
      "renovate.json",
      ".openspec-e2e-kit.json"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  }
}
